meta {
  name: 02 - Login Invalid Credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "student",
    "password": "wrongpassword"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Invalid login
}

tests {
  test("Should reject invalid credentials with 401", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("Invalid login");
  });
}
