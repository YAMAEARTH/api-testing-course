meta {
  name: 06 - Create Order Unauthorized
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Unauthorized
}

tests {
  test("Should reject order without Bearer token with 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("Unauthorized");
  });
}
