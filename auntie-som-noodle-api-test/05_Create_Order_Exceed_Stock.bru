meta {
  name: 05 - Create Order Exceed Stock
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "itemId": 1,
    "quantity": 10
  }
}

tests {
  test("Should reject order when quantity exceeds available stock", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.have.property("error");
  });
}
